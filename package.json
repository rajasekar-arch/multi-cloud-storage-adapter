{
  "name": "multi-cloud-storage-adapter",
  "version": "1.0.1",
  "description": "An npm package that provides a single, unified, and strongly-typed API for common file storage operations across various cloud providers.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rajasekar-arch/multi-cloud-storage-adapter.git"
  },
  "keywords": [
    "cloud",
    "storage",
    "aws",
    "s3",
    "google cloud storage",
    "gcs",
    "azure blob",
    "digitalocean spaces",
    "multi-cloud",
    "typescript",
    "adapter",
    "unified api"
  ],
  "author": "RAJASEKAR E C <rajasekar_e_c@outlook.com>",
  "license": "MIT",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/rajasekar-arch/multi-cloud-storage-adapter/issues"
  },
  "homepage": "https://github.com/rajasekar-arch/multi-cloud-storage-adapter#readme",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.x",
    "@aws-sdk/s3-request-presigner": "^3.x",
    "@azure/core-client": "^1.9.4",
    "@azure/core-rest-pipeline": "^1.21.0",
    "@azure/storage-blob": "^12.27.0",
    "@google-cloud/storage": "^7.x",
    "@types/node": "^24.0.10",
    "stream": "npm:@types/node@^20.14.9"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.9",
    "@typescript-eslint/eslint-plugin": "^7.14.1",
    "@typescript-eslint/parser": "^7.14.1",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "prettier": "^3.3.2",
    "ts-jest": "^29.1.5",
    "typescript": "^5.8.3"
  },
  "peerDependencies": {
    "@aws-sdk/client-s3": "^3.x",
    "@aws-sdk/s3-request-presigner": "^3.x",
    "@google-cloud/storage": "^7.x"
  }
}
